<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>想樂 x amba集團 特色場地合作提案</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --stone:#EDE7DC;
    --stone-deep:#E2DACB;
    --ink:#2A2420;
    --ink-soft:#5B5148;
    --slate:#6E8299;
    --slate-deep:#425466;
    --brass:#A8783F;
    --line:#CFC5B2;
    --card:#F6F2E9;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;background:var(--ink);}
  html{font-size:19px;}
  body{
    font-family:'Noto Sans TC','Noto Sans CJK TC',sans-serif;
    color:var(--ink);
    overflow:hidden;
  }
  .serif{font-family:'Noto Serif TC','Noto Serif CJK TC',serif;}
  #deck{
    position:relative;
    width:100vw;height:100vh;
  }
  .slide{
    position:absolute;top:0;left:0;
    width:100%;height:100%;
    background:var(--stone);
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:6.5vh 9vw;
    opacity:0;
    transform:translateX(40px);
    transition:opacity .5s ease, transform .5s ease;
    pointer-events:none;
  }
  .slide.active{
    opacity:1;
    transform:translateX(0);
    pointer-events:auto;
    z-index:2;
  }
  .kicker{
    font-size:.78rem;
    letter-spacing:.14em;
    color:var(--slate-deep);
    margin-bottom:1.1rem;
    font-weight:500;
  }
  h1{
    font-size:clamp(2rem,4vw,3.4rem);
    line-height:1.28;
    font-weight:600;
    color:var(--ink);
  }
  h2{
    font-size:clamp(1.6rem,2.6vw,2.3rem);
    font-weight:500;
    line-height:1.4;
    margin-bottom:2rem;
  }
  p.lede{
    font-size:1.08rem;
    color:var(--ink-soft);
    line-height:1.9;
    max-width:640px;
  }
  .num{
    position:absolute;
    bottom:6vh;left:9vw;
    font-size:.85rem;
    color:var(--ink-soft);
    letter-spacing:.05em;
  }

  /* ---- Cover ---- */
  #slide-1{padding:0;background:#1c1a16;}
  .cover-bg{
    position:absolute;inset:0;
    background-size:cover;background-position:center 30%;
    filter:brightness(.55) saturate(1.05);
  }
  .cover-content{
    position:relative;z-index:1;
    height:100%;
    display:flex;flex-direction:column;justify-content:flex-end;
    padding:8vh 9vw;
    color:#F6F2E9;
  }
  .cover-content .kicker{color:#D8CDBB;}
  .cover-content h1{color:#F6F2E9;font-size:clamp(2.4rem,5.4vw,4.4rem);}
  .cover-sub{
    margin-top:1.4rem;font-size:1.15rem;color:#E7DFCF;font-weight:300;
    border-top:1px solid rgba(255,255,255,.28);
    padding-top:1.4rem;max-width:560px;
  }

  /* ---- Stat slide ---- */
  .stat-wrap{display:flex;align-items:center;gap:6vw;}
  .stat-fraction{
    font-family:'Noto Serif TC','Noto Serif CJK TC',serif;
    font-size:clamp(4.5rem,11vw,8rem);
    font-weight:600;
    color:var(--slate-deep);
    line-height:1;
    white-space:nowrap;
  }
  .stat-fraction sup{font-size:.42em;color:var(--brass);vertical-align:.55em;}
  .stat-side{border-left:1px solid var(--line);padding-left:3.2vw;max-width:420px;}
  .stat-side p{color:var(--ink-soft);line-height:1.9;font-size:1.05rem;margin-bottom:1rem;}

  /* ---- lists ---- */
  ul.plain{list-style:none;}
  ul.plain li{
    padding:1.05rem 0;
    border-bottom:1px solid var(--line);
    font-size:1.08rem;
    display:flex;gap:1.4rem;
    color:var(--ink);
  }
  ul.plain li:first-child{border-top:1px solid var(--line);}
  ul.plain li .tag{
    flex:0 0 auto;font-family:'Noto Serif TC','Noto Serif CJK TC',serif;color:var(--brass);font-weight:600;font-size:.95rem;padding-top:.1rem;
  }

  /* ---- two column ---- */
  .cols{display:flex;gap:4vw;margin-top:.5rem;}
  .col{flex:1;}
  .col h3{font-family:'Noto Serif TC','Noto Serif CJK TC',serif;font-size:1.25rem;margin-bottom:1rem;color:var(--slate-deep);}
  .col.dim h3{color:var(--ink-soft);}
  .col ul{list-style:none;}
  .col li{padding:.55rem 0;color:var(--ink-soft);line-height:1.7;font-size:.98rem;border-bottom:1px dashed var(--line);}
  .col li a{color:var(--slate-deep);text-decoration:none;border-bottom:1px solid var(--slate);padding-bottom:1px;}
  .col li a:hover{color:var(--brass);border-color:var(--brass);}
  .col.highlight{
    background:var(--card);
    padding:2.2rem 2.4rem;border-radius:2px;
    box-shadow:inset 0 0 0 1px var(--line);
  }
  .col.highlight h3{color:var(--slate-deep);}

  /* ---- grid points ---- */
  .grid4{display:grid;grid-template-columns:1fr 1fr;gap:2.6rem 3.4vw;margin-top:1rem;}
  .point .k{font-family:'Noto Serif TC','Noto Serif CJK TC',serif;color:var(--brass);font-size:1.05rem;margin-bottom:.5rem;}
  .point p{color:var(--ink-soft);font-size:.98rem;line-height:1.75;}

  /* ---- before/after ---- */
  .ba-wrap{display:flex;gap:2.4vw;align-items:flex-end;height:32vh;margin-top:.5rem;}
  .ba-item{flex:1;height:100%;position:relative;border-radius:2px;overflow:hidden;}
  .ba-item img{width:100%;height:100%;object-fit:cover;display:block;}
  .ba-label{
    position:absolute;top:0;left:0;
    background:rgba(42,36,32,.82);color:#F6F2E9;
    font-size:.82rem;letter-spacing:.08em;padding:.5rem 1rem;
  }
  .ba-caption{margin-top:2.2vh;max-width:640px;color:var(--ink-soft);line-height:1.85;font-size:1rem;}

  /* ---- cost table ---- */
  .cost-table{width:100%;border-collapse:collapse;margin-top:1rem;}
  .cost-table th{
    text-align:left;font-weight:500;font-size:.85rem;color:var(--ink-soft);
    padding-bottom:.9rem;border-bottom:1px solid var(--ink);letter-spacing:.04em;
  }
  .cost-table td{
    padding:1.2rem 0;border-bottom:1px solid var(--line);
    font-size:1rem;color:var(--ink);vertical-align:top;
  }
  .cost-table td.item{color:var(--ink-soft);width:34%;}
  .cost-table strong{color:var(--slate-deep);font-family:'Noto Serif TC','Noto Serif CJK TC',serif;font-weight:600;}

  /* ---- closing ---- */
  #slide-12{background:#1c1a16;padding:0;}
  .close-bg{position:absolute;inset:0;background-size:cover;background-position:center;filter:brightness(.4);}
  .close-content{position:relative;z-index:1;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#F6F2E9;}
  .close-content h1{color:#F6F2E9;margin-bottom:1.6rem;}
  .close-content .contact{font-size:1rem;color:#DCD2C0;line-height:2;}

  /* ---- nav ---- */
  .navzone{position:absolute;top:0;height:100%;width:14%;z-index:5;cursor:pointer;}
  .navzone.left{left:0;}
  .navzone.right{right:0;}
  #progress{
    position:fixed;bottom:3.4vh;left:50%;transform:translateX(-50%);
    display:flex;gap:.5rem;z-index:10;
  }
  #progress .dot{width:6px;height:6px;border-radius:50%;background:rgba(0,0,0,.18);transition:background .3s, width .3s;}
  #progress .dot.on{background:var(--brass);width:18px;border-radius:3px;}
  #slide-1 ~ #progress .dot, body.dark-dots #progress .dot{background:rgba(255,255,255,.3);}
  #counter{
    position:fixed;top:3.4vh;right:9vw;z-index:10;
    font-size:.8rem;color:var(--ink-soft);letter-spacing:.05em;
  }
  body.on-dark #counter{color:#DCD2C0;}


  .brand-mark{position:absolute;z-index:3;height:34px;}
  .brand-mark.on-cover{top:5vh;left:9vw;height:30px;filter:drop-shadow(0 1px 3px rgba(0,0,0,.4));}
  .brand-mark.on-close{height:46px;margin-bottom:1.6rem;}

  .gallery-row{display:flex;gap:1.6vw;margin-top:2.2vh;height:22vh;}
  .gallery-row .g-item{flex:1;border-radius:2px;overflow:hidden;}
  .gallery-row .g-item img{width:100%;height:100%;object-fit:cover;display:block;}
  .gallery-cap{margin-top:.9vh;font-size:.8rem;letter-spacing:.06em;color:var(--ink-soft);}
  .icon-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:2.6rem 2.6vw;margin-top:1rem;}
  .icon-grid.two-col{grid-template-columns:1fr 1fr;}
  .ic{
    width:46px;height:46px;border-radius:50%;
    border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    margin-bottom:1rem;color:var(--brass);
  }
  .ic svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.4;}
  .icon-card h4{font-family:'Noto Serif TC','Noto Serif CJK TC',serif;font-weight:600;font-size:1.02rem;color:var(--ink);margin-bottom:.4rem;}
  .icon-card p{color:var(--ink-soft);font-size:.92rem;line-height:1.7;}
  .flow-arrow{
    display:flex;align-items:center;justify-content:center;
    color:var(--brass);flex:0 0 auto;
  }
  .flow-arrow svg{width:32px;height:32px;stroke:currentColor;fill:none;stroke-width:1.3;}
  .cols.with-arrow{align-items:center;}

  @media print{
    body{overflow:visible;}
    .slide{position:static;opacity:1;transform:none;page-break-after:always;height:100vh;}
    .navzone,#progress,#counter{display:none;}
  }
</style>
</head>
<body>

<div id="deck">

  <section class="slide active" id="slide-1">
